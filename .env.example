# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME="AI Risk Manager"
VERSION="1.0.0"
DEBUG=true
PORT=8000

# Comma-separated allowed CORS origins. Use * for open access (dev only).
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app"

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Neon database connection string with your actual password
DATABASE_URL=postgresql://neondb_owner:password@ep-server-name.region.aws.neon.tech/neondb

# Individual settings (derived from connection string above)
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=ep-server-name.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0   # use redis://redis:6379/0 in Docker

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-very-long-random-secret-key

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── LLM — Google Gemini ───────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# ── ML Models ─────────────────────────────────────────────────────────────────
MODEL_DIR=app/ml/models
MODEL_VERSION=1.0.0

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=5.0

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Email (Resend SMTP) ───────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# For development, use: onboarding@resend.dev (Resend's testing domain)
# For production, verify your own domain in Resend dashboard
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=AI Risk Manager
FRONTEND_URL=http://localhost:5173
